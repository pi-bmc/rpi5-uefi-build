-  if (EFI_ERROR (Status)) {
-    return Status;
+  //
+  // A PCI ancestor is the default and stays the preferred case: a UNDI on a
+  // PCI bus uses its EFI_PCI_IO_PROTOCOL for the CPB/DB/CDB and Tx/Rx
+  // allocations and for the UNDI memory-mapping callbacks.
+  //
+  // A UNDI reached over USB is the accepted alternative. EFI_USB_IO_PROTOCOL
+  // exposes no DMA surface at all -- no AllocateBuffer, no Map, no Unmap --
+  // and needs none: the USB host controller driver owns the bus mastering,
+  // bounce buffering included, so a USB UNDI performs its own I/O and never
+  // asks SNP to translate an address. Finding UsbIo in the ancestry is
+  // therefore proof that the PciIo services are not required here, not a
+  // substitute for them; the allocations fall back to plain pages and the
+  // mapping callbacks refuse.
+  //
+  // A UNDI on neither bus is still refused, exactly as before.
+  //
+  // On a Raspberry Pi 5 this is precisely the difference between the two USB
+  // controllers. A CDC-NCM gadget on an RP1 xHCI port is rooted in PCI,
+  // because RP1 is a PCIe device. The same gadget on the BCM2712 DWC2 port
+  // hangs off a bare vendor-hardware device path, so the PCI lookup fails;
+  // Supported() had already succeeded and NetworkCommon had published its
+  // NII, but Start() returned here and no EFI_SIMPLE_NETWORK_PROTOCOL was
+  // ever produced.
+  //
+  PciIo        = NULL;
+  AncestorPath = NiiDevicePath;
+  Status       = gBS->LocateDevicePath (
+                        &gEfiPciIoProtocolGuid,
+                        &AncestorPath,
+                        &Handle
+                        );
+  if (!EFI_ERROR (Status)) {
+    Status = gBS->OpenProtocol (
+                    Handle,
+                    &gEfiPciIoProtocolGuid,
+                    (VOID **)&PciIo,
+                    This->DriverBindingHandle,
+                    Controller,
+                    EFI_OPEN_PROTOCOL_GET_PROTOCOL
+                    );
   }
 
-  Status = gBS->OpenProtocol (
-                  Handle,
-                  &gEfiPciIoProtocolGuid,
-                  (VOID **)&PciIo,
-                  This->DriverBindingHandle,
-                  Controller,
-                  EFI_OPEN_PROTOCOL_GET_PROTOCOL
-                  );
   if (EFI_ERROR (Status)) {
-    return Status;
+    PciIo        = NULL;
+    AncestorPath = NiiDevicePath;
+    Status       = gBS->LocateDevicePath (
+                          &gEfiUsbIoProtocolGuid,
+                          &AncestorPath,
+                          &Handle
+                          );
+    if (EFI_ERROR (Status)) {
+      gBS->CloseProtocol (
+             Controller,
+             &gEfiDevicePathProtocolGuid,
+             This->DriverBindingHandle,
+             Controller
+             );
+      return Status;
+    }
   }
 
   //
@@ -382,7 +446,11 @@
     return Status;
   }
 
-  DEBUG ((DEBUG_INFO, "Start(): UNDI3.1 found\n"));
+  DEBUG ((
+    DEBUG_INFO,
+    "Start(): UNDI3.1 found%a\n",
+    (PciIo == NULL) ? " (USB ancestor, no PciIo)" : ""
+    ));
 
   Pxe = (PXE_UNDI *)(UINTN)(Nii->Id);
 
@@ -486,42 +554,21 @@
   // -it is OK to allocate one global set of CPB, DB pair for each UNDI
   // interface as EFI does not multi-task and so SNP will not be re-entered!
   //
-  Status = PciIo->AllocateBuffer (
-                    PciIo,
-                    AllocateAnyPages,
-                    EfiBootServicesData,
-                    SNP_MEM_PAGES (EFI_PAGE_SIZE),
-                    &Snp->Cpb,
-                    0
-                    );
+  Status = SnpAllocateBuffer (Snp, SNP_MEM_PAGES (EFI_PAGE_SIZE), (VOID **)&Snp->Cpb);
 
   if (Status != EFI_SUCCESS) {
     DEBUG ((DEBUG_NET, "\nCould not allocate CPB structure.\n"));
     goto ErrorDeleteSnp;
   }
 
-  Status = PciIo->AllocateBuffer (
-                    PciIo,
-                    AllocateAnyPages,
-                    EfiBootServicesData,
-                    SNP_MEM_PAGES (EFI_PAGE_SIZE),
-                    &Snp->Db,
-                    0
-                    );
+  Status = SnpAllocateBuffer (Snp, SNP_MEM_PAGES (EFI_PAGE_SIZE), (VOID **)&Snp->Db);
 
   if (Status != EFI_SUCCESS) {
     DEBUG ((DEBUG_NET, "\nCould not allocate DB structure.\n"));
     goto ErrorDeleteSnp;
   }
 
-  Status = PciIo->AllocateBuffer (
-                    PciIo,
-                    AllocateAnyPages,
-                    EfiBootServicesData,
-                    SNP_MEM_PAGES (sizeof (PXE_CDB)),
-                    (VOID **)&Snp->Cdb,
-                    0
-                    );
+  Status = SnpAllocateBuffer (Snp, SNP_MEM_PAGES (sizeof (PXE_CDB)), (VOID **)&Snp->Cdb);
 
   if (Status != EFI_SUCCESS) {
     DEBUG ((DEBUG_NET, "\nCould not allocate CDB structure.\n"));
@@ -543,7 +590,7 @@
   Snp->IoBarIndex     = PCI_MAX_BAR;
   FoundMemoryBar      = FALSE;
   FoundIoBar          = FALSE;
-  for (BarIndex = 0; BarIndex < PCI_MAX_BAR; BarIndex++) {
+  for (BarIndex = 0; (PciIo != NULL) && (BarIndex < PCI_MAX_BAR); BarIndex++) {
     Status = PciIo->GetBarAttributes (
                       PciIo,
                       BarIndex,
