-                 PciIo,
-                 SNP_MEM_PAGES (sizeof (PXE_CDB)),
-                 (VOID *)(UINTN)Snp->Cdb
-                 );
-      }
+    if (Snp->Cpb != NULL) {
+      SnpFreeBuffer (Snp, SNP_MEM_PAGES (EFI_PAGE_SIZE), Snp->Cpb);
+    }
+
+    if (Snp->Db != NULL) {
+      SnpFreeBuffer (Snp, SNP_MEM_PAGES (EFI_PAGE_SIZE), Snp->Db);
+    }
+
+    if (Snp->Cdb != NULL) {
+      SnpFreeBuffer (Snp, SNP_MEM_PAGES (sizeof (PXE_CDB)), (VOID *)(UINTN)Snp->Cdb);
     }
 
     if (Snp->RecycledTxBuf != NULL) {
@@ -311,6 +335,7 @@
 {
