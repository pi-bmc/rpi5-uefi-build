   EFI_DEVICE_PATH_PROTOCOL                   *NiiDevicePath;
+  EFI_DEVICE_PATH_PROTOCOL                   *AncestorPath;
   EFI_STATUS                                 Status;
   PXE_UNDI                                   *Pxe;
   SNP_DRIVER                                 *Snp;
@@ -339,26 +364,65 @@
     return Status;
   }
 
