+//
+// The device tree the VPU firmware loaded and patched. We do not hand this to
+// the OS when the OS brings its own -- we mine it for the values only it
+// carries. See UpdateFdtFromFw().
+//
+STATIC VOID                             *mFwFdtImage;
+
+//
+// EFI_DT_FIXUP_PROTOCOL. Not an edk2 protocol: it was defined by u-boot
+// (lib/efi_loader/efi_dt_fixup.c) and is what systemd-boot calls from
+// src/boot/devicetree.c, for both a loader entry's "devicetree" file and a
+// UKI's .dtb/.dtbauto section.
+//
+// It exists to get the dependency the right way round. A device tree has to
+// match the kernel that consumes it, and firmware does not ship that kernel --
+// so the OS supplies the tree and the firmware writes its board knowledge into
+// it, rather than the firmware shipping a tree and hoping it fits.
+//
+#define EFI_DT_FIXUP_PROTOCOL_REVISION  0x00010000
+
+#define EFI_DT_APPLY_FIXUPS             0x00000001
+#define EFI_DT_RESERVE_MEMORY           0x00000002
+#define EFI_DT_INSTALL_TABLE            0x00000004
+#define EFI_DT_ALL                      (EFI_DT_APPLY_FIXUPS | \
+                                         EFI_DT_RESERVE_MEMORY | \
+                                         EFI_DT_INSTALL_TABLE)
+
+typedef struct _EFI_DT_FIXUP_PROTOCOL EFI_DT_FIXUP_PROTOCOL;
+
+typedef
+EFI_STATUS
+(EFIAPI *EFI_DT_FIXUP)(
+  IN     EFI_DT_FIXUP_PROTOCOL  *This,
+  IN OUT VOID                   *Fdt,
+  IN OUT UINTN                  *BufferSize,
+  IN     UINT32                 Flags
+  );
+
+struct _EFI_DT_FIXUP_PROTOCOL {
+  UINT64          Revision;
+  EFI_DT_FIXUP    Fixup;
+};
+
+STATIC EFI_GUID mEfiDtFixupProtocolGuid = {
+  0xe617d64c, 0xfe08, 0x46da, { 0xf4, 0xdc, 0xbb, 0xd5, 0x87, 0x0c, 0x73, 0x00 }
+};
+
+//
+// Slack added on top of the caller's tree before we start adding properties.
+// systemd-boot retries a EFI_BUFFER_TOO_SMALL exactly once, so whatever we ask
+// for has to be enough the second time round -- a page is far more than the
+// dozen small properties below can consume.
+//
+#define FDT_FIXUP_HEADROOM  SIZE_4KB
+
 STATIC RASPBERRY_PI_FIRMWARE_PROTOCOL   *mFwProtocol;
 STATIC UINT32                           mBoardRevision;
 
