+/**
+  Copy one property out of the firmware device tree into the tree being built.
+
+  Absence is not an error on either side: the firmware only populates what the
+  board actually has, and the upstream tree names some nodes differently, so a
+  miss just means "nothing to carry across". Mirrors u-boot's copy_property().
+
+  @param  SrcPath[in]   Node path (or alias) in the firmware tree.
+  @param  DstPath[in]   Node path (or alias) in the tree being built.
+  @param  Property[in]  Property to copy.
+
+**/
+STATIC
+VOID
+CopyFwPropertyEx (
+  IN CONST CHAR8 *SrcPath,
+  IN CONST CHAR8 *DstPath,
+  IN CONST CHAR8 *Property
+  )
+{
+  INT32      SrcNode;
+  INT32      DstNode;
+  INT32      Length;
+  CONST VOID *Value;
+
+  SrcNode = FdtPathOffset (mFwFdtImage, SrcPath);
+  DstNode = FdtPathOffset (mFdtImage, DstPath);
+  if ((SrcNode < 0) || (DstNode < 0)) {
+    return;
+  }
+
+  Value = FdtGetProp (mFwFdtImage, SrcNode, Property, &Length);
+  if (Value == NULL) {
+    return;
+  }
+
+  if (FdtSetProp (mFdtImage, DstNode, Property, Value, Length) != 0) {
+    DEBUG ((DEBUG_WARN, "%a: could not set %a of %a\n", __func__, Property, DstPath));
+  }
+}
+
+STATIC
+VOID
+CopyFwProperty (
+  IN CONST CHAR8 *Path,
+  IN CONST CHAR8 *Property
+  )
+{
+  CopyFwPropertyEx (Path, Path, Property);
+}
+
+/**
+  Lift the values only the VPU firmware knows into the tree we hand the OS.
+
+  The upstream device tree describes the board; it cannot describe this board:
+  the model string, the per-SKU DMA windows, where the bootloader config blob
+  landed, the KASLR seed and the OTP MAC address are all computed at runtime
+  and written into the firmware's own tree. This is u-boot's
+  update_fdt_from_fw(), which exists for exactly the same reason.
+
+**/
+STATIC
+VOID
+UpdateFdtFromFw (
+  VOID
+  )
+{
+  CopyFwProperty ("/", "model");
+  CopyFwProperty ("/reserved-memory/linux,cma", "size");
+
+  //
+  // dma-ranges vary with silicon revision. The firmware tree exposes no
+  // pcie0/1/2 aliases on BCM2712, so address the three root ports by path.
+  //
+  CopyFwProperty ("/axi/pcie@1000100000", "dma-ranges");
+  CopyFwProperty ("/axi/pcie@1000110000", "dma-ranges");
+  CopyFwProperty ("/axi/pcie@1000120000", "dma-ranges");
+
+  //
+  // Bootloader configuration block, exposed to the OS as nvmem. Only
+  // meaningful once the firmware has patched in where it put it.
+  //
+  CopyFwProperty ("blconfig", "reg");
+  CopyFwProperty ("blconfig", "status");
+
+  CopyFwProperty ("/chosen", "kaslr-seed");
+  CopyFwProperty ("/chosen", "user-warnings");
+  CopyFwProperty ("/chosen", "log");
+
+  //
+  // The RP1 GEM's OTP MAC address, and the PHY's MDIO address. Upstream put
+  // the PHY under an "mdio" subnode; the firmware tree keeps it a direct
+  // child of the MAC. Try both shapes -- the one that does not exist is a
+  // no-op, so this keeps working across either layout moving.
+  //
+  CopyFwProperty ("ethernet0", "local-mac-address");
+  CopyFwPropertyEx ("ethernet0/ethernet-phy@1", "ethernet0/mdio/ethernet-phy@1", "reg");
+  CopyFwProperty ("ethernet0/ethernet-phy@1", "reg");
+
+  //
+  // Bluetooth address, off the UART the on-board module hangs from. RPi4 and
+  // RPi5 put that UART at different paths.
+  //
+  CopyFwProperty ("/soc/serial@7e201000/bluetooth", "local-bd-address");
+  CopyFwProperty ("/soc@107c000000/serial@7d50c000/bluetooth", "local-bd-address");
+
+  CopyFwProperty ("/clocks/clk-uart", "clock-frequency");
+}
