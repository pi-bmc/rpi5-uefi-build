 #define FDT_FIXUP_HEADROOM  SIZE_4KB
 
+//
+// Where a device tree may be placed on the OS's own filesystem.
+//
+// This is the answer to a firmware that would otherwise have to be reflashed
+// for every kernel: the device tree has to match the kernel, so let it live
+// with the kernel's installation instead of on the firmware's card. Whoever
+// installs the OS drops the tree its kernel was built against here, and the
+// same firmware image boots it.
+//
+// One fixed name, deliberately. Guessing between the Pi 5 variants
+// (bcm2712-rpi-5-b / bcm2712d0-rpi-5-b / bcm2712-d-rpi-5-b) from a board
+// revision would put us in the business of reimplementing the VPU
+// bootloader's model-to-filename mapping, and getting it wrong hands the OS a
+// tree for different silicon. Placing the right file is the installer's job,
+// exactly as it is for config.txt's device_tree=.
+//
+#define FDT_OS_PATH  L"\\dtb\\bcm2712-rpi-5-b.dtb"
+
 STATIC RASPBERRY_PI_FIRMWARE_PROTOCOL   *mFwProtocol;
 STATIC UINT32                           mBoardRevision;
 
