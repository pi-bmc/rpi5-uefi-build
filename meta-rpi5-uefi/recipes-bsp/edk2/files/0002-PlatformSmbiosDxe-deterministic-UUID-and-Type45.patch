 /**
 
@@ -864,6 +903,8 @@ SysInfoUpdateSmbiosType1 (
 {
   EFI_STATUS Status = EFI_SUCCESS;
   UINT64 BoardSerial = 0;
+  UINT8 *UuidBytes;
+  UINTN Index;
 
   AsciiStrCpyS (mSysInfoProductName, sizeof (mSysInfoProductName),
     BoardRevisionGetModelName (mBoardRevisionCode));
@@ -883,12 +924,32 @@ SysInfoUpdateSmbiosType1 (
 
   DEBUG ((DEBUG_ERROR, "Board Serial Number: %a\n", mSysInfoSerial));
 
-  mSysInfoType1.Uuid.Data1 = mBoardRevisionCode;
-  mSysInfoType1.Uuid.Data2 = 0x0;
-  mSysInfoType1.Uuid.Data3 = 0x0;
-  // Swap endianness, so that the serial is more user-friendly as a UUID
-  BoardSerial = SwapBytes64 (BoardSerial);
-  CopyMem (mSysInfoType1.Uuid.Data4, &BoardSerial, sizeof (BoardSerial));
+  //
+  // Derive a deterministic UUID from the board serial and revision, using
+  // the same construction as U-Boot's Raspberry Pi sysinfo driver, so that
+  // the reported system identity is identical under either firmware:
+  //   bytes 0..7   = 64-bit board serial, little-endian
+  //   bytes 8..11  = 32-bit board revision, little-endian
+  //   bytes 12..15 = 'R', 'P', 'i', 0x00
+  // then stamped as UUID version 4, variant 1.
+  //
+  // Fill the field byte-wise through a UINT8 view so the bytes stored in
+  // the table match that byte array exactly, independent of EFI_GUID's
+  // mixed-endian field layout.
+  //
+  UuidBytes = (UINT8 *)&mSysInfoType1.Uuid;
+  for (Index = 0; Index < 8; Index++) {
+    UuidBytes[Index] = (UINT8)(BoardSerial >> (8 * Index));
+  }
+  for (Index = 0; Index < 4; Index++) {
+    UuidBytes[8 + Index] = (UINT8)(mBoardRevisionCode >> (8 * Index));
+  }
+  UuidBytes[12] = 'R';
+  UuidBytes[13] = 'P';
+  UuidBytes[14] = 'i';
+  UuidBytes[15] = 0x00;
+  UuidBytes[6]  = (UuidBytes[6] & 0x0F) | 0x40; // version 4
+  UuidBytes[8]  = (UuidBytes[8] & 0x3F) | 0x80; // variant 1
 
   LogSmbiosData ((EFI_SMBIOS_TABLE_HEADER*)&mSysInfoType1, mSysInfoType1Strings, NULL);
 }
