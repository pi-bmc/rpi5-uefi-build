+/***********************************************************************
+        SMBIOS data update  TYPE45  Firmware Inventory Information
+************************************************************************/
+VOID
+FwInventoryUpdateSmbiosType45 (
+  VOID
+  )
+{
+  STATIC CONST CHAR8 Hex[] = "0123456789abcdef";
+  VOID          *Fdt;
+  INT32         Node;
+  CONST UINT8   *Property;
+  INT32         Length;
+  INT32         Index;
+  INT32         CopyLength;
+  BOOLEAN       IsString;
+  UINT32        EpochSeconds;
+  EFI_TIME      Time;
+
+  Fdt = FdtPlatformGetBase ();
+  if (Fdt == NULL) {
+    return;
+  }
+
+  //
+  // The VPU bootloader (rpi-eeprom) describes itself under
+  // /chosen/bootloader in the firmware-provided device tree. If the node
+  // is absent (e.g. older VPU firmware), skip the record silently.
+  //
+  Node = FdtPathOffset (Fdt, "/chosen/bootloader");
+  if (Node < 0) {
+    return;
+  }
+
+  //
+  // 'version' holds the bootloader git hash, either as a printable string
+  // or as a raw byte array; render the latter as a hex string.
+  //
+  Property = FdtGetProp (Fdt, Node, "version", &Length);
+  if ((Property != NULL) && (Length > 0)) {
+    IsString = (BOOLEAN)(Property[Length - 1] == '\0' && Length > 1);
+    for (Index = 0; IsString && (Index < Length - 1); Index++) {
+      if ((Property[Index] < 0x20) || (Property[Index] > 0x7E)) {
+        IsString = FALSE;
+      }
+    }
+
+    if (IsString) {
+      CopyLength = MIN (Length - 1, (INT32)sizeof (mFwInventoryId) - 1);
+      CopyMem (mFwInventoryId, Property, CopyLength);
+      mFwInventoryId[CopyLength] = '\0';
+    } else {
+      CopyLength = MIN (Length, (INT32)(sizeof (mFwInventoryId) - 1) / 2);
+      for (Index = 0; Index < CopyLength; Index++) {
+        mFwInventoryId[Index * 2]     = Hex[Property[Index] >> 4];
+        mFwInventoryId[Index * 2 + 1] = Hex[Property[Index] & 0xF];
+      }
+      mFwInventoryId[CopyLength * 2] = '\0';
+    }
+  }
+
+  //
+  // 'build-timestamp' (or, failing that, 'update-timestamp') is the
+  // bootloader build time as a big-endian epoch value.
+  //
+  Property = FdtGetProp (Fdt, Node, "build-timestamp", &Length);
+  if ((Property == NULL) ||
+      ((Length != sizeof (UINT32)) && (Length != sizeof (UINT64)))) {
+    Property = FdtGetProp (Fdt, Node, "update-timestamp", &Length);
+  }
+
+  if ((Property != NULL) &&
+      ((Length == sizeof (UINT32)) || (Length == sizeof (UINT64)))) {
+    if (Length == sizeof (UINT64)) {
+      EpochSeconds = (UINT32)Fdt64ToCpu (*(CONST UINT64 *)(CONST VOID *)Property);
+    } else {
+      EpochSeconds = Fdt32ToCpu (*(CONST UINT32 *)(CONST VOID *)Property);
+    }
+
+    EpochToEfiTime (EpochSeconds, &Time);
+    AsciiSPrint (mFwInventoryVersion, sizeof (mFwInventoryVersion),
+      "%04d.%02d%02d", Time.Year, Time.Month, Time.Day);
+    AsciiSPrint (mFwInventoryDate, sizeof (mFwInventoryDate),
+      "%04d-%02d-%02d", Time.Year, Time.Month, Time.Day);
+  }
+
+  LogSmbiosData ((EFI_SMBIOS_TABLE_HEADER*)&mFwInventoryType45, mFwInventoryType45Strings, NULL);
+}
+
 /***********************************************************************
         Driver Entry
 ************************************************************************/
@@ -1154,5 +1304,7 @@ PlatformSmbiosDriverEntryPoint (
 
   BootInfoUpdateSmbiosType32 ();
 
+  FwInventoryUpdateSmbiosType45 ();
+
   return EFI_SUCCESS;
 }
