#/** @file
#
#  RpiRedfishPkg - Raspberry Pi 5 <-> BMC Redfish-over-USB glue.
#
#  EDK2 Redfish Host Interface (DSP0270) support for the Pi 5, talking to
#  the pi-bmc nanokvm BMC's Redfish service over the BMC's USB CDC-NCM
#  gadget on an RP1 USB port. The JetKVM/NUC method (see nuc-bios-build's
#  NucRedfishPkg), with CDC-NCM in place of CDC-ECM.
#
#  This package replaces the I2C shared-EEPROM sync stack that RpiBmcPkg
#  used to carry: SMBIOS identity and drive inventory now go host->BMC as
#  Redfish PATCHes/POSTs, and BMC->host boot control comes back as the
#  ComputerSystem one-time boot override instead of EEPROM variable writes.
#
#  Deployment contract (both sides MUST agree - see README.md):
#    host (Pi 5, UEFI)  169.254.10.2/16   static, from the type 42 record
#    service (BMC)      169.254.10.1/16   nanokvm ncm usb0, HTTP :80
#    gadget host_addr   = PcdRpiRedfishGadgetMac, and the same MAC in
#                         PcdRedfishRestExServiceDevicePath (RpiRedfish.dsc.inc)
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
#**/

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = RpiRedfishPkg
  PACKAGE_GUID                   = 5b1a7c9e-2d64-48f3-9c0a-7e8b4d21c6a3
  PACKAGE_VERSION                = 1.0

[Guids]
  gRpiRedfishTokenSpaceGuid = { 0x7c3e8f52, 0x1b9a, 0x4d07, { 0xa6, 0x54, 0x2e, 0x91, 0xc8, 0x3f, 0x7b, 0x24 } }

[PcdsFixedAtBuild]
  ## MAC address of the host-side NIC the BMC's CDC-NCM gadget presents to
  ## the Pi (the gadget's host_addr, NOT its dev_addr). RedfishDiscoverDxe
  ## rejects the interface unless the SMBIOS type 42 record byte-matches the
  ## real NIC MAC, so the BMC gadget must present exactly this fixed value.
  ## Must also be encoded in PcdRedfishRestExServiceDevicePath - both are
  ## rendered from the recipe's RPI5_REDFISH_MAC in RpiRedfish.dsc.inc.
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetMac|{0xDA, 0xC0, 0xFF, 0xEE, 0x10, 0x02}|VOID*|0x00000001

  ## Static IPv4 addressing on the isolated point-to-point NCM link. The
  ## values mirror nanokvm-app's RHI defaults (pkg/config: 169.254.10.1/16
  ## with lease 169.254.10.2); the host takes its address statically from
  ## the type 42 record, which the BMC's RHI DHCP lease agrees with.
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishHostIp|{0xA9, 0xFE, 0x0A, 0x02}|VOID*|0x00000002
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishServiceIp|{0xA9, 0xFE, 0x0A, 0x01}|VOID*|0x00000003
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishIpMask|{0xFF, 0xFF, 0x00, 0x00}|VOID*|0x00000004

  ## USB idVendor/idProduct the BMC's composite gadget advertises
  ## (informational in the type 42 USB descriptor; discovery matches on MAC).
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetVendorId|0x1D6B|UINT16|0x00000005
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetProductId|0x0104|UINT16|0x00000006

  ## HTTP Basic credentials for the BMC's Redfish service (nanokvm-app puts
  ## /redfish/v1 behind CheckAuth unless authentication is disabled). An
  ## empty user string means the service is unauthenticated and the
  ## credential library reports AuthMethodNone instead.
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishUser|"admin"|VOID*|0x00000007
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishPassword|"admin"|VOID*|0x00000008
