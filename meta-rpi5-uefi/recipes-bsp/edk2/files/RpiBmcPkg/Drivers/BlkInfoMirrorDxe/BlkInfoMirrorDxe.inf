## @file
#
#  BlkInfoMirrorDxe - mirror the block-device inventory (BLK1 + JSON) to
#  the BMC's shared EEPROM at ReadyToBoot.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = BlkInfoMirrorDxe
  FILE_GUID                      = 18cd59d1-7c95-4678-be19-1649a1fc9725
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BlkInfoMirrorEntryPoint

[Sources]
  BlkInfoMirrorDxe.c

[Packages]
  MdePkg/MdePkg.dec
  RpiBmcPkg/RpiBmcPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  BmcEepromLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib

[Protocols]
  gEfiBlockIoProtocolGuid                       ## CONSUMES
  gEfiDevicePathProtocolGuid                    ## SOMETIMES_CONSUMES
  gEfiDiskInfoProtocolGuid                      ## SOMETIMES_CONSUMES

[Guids]
  gEfiDiskInfoNvmeInterfaceGuid                 ## SOMETIMES_CONSUMES
  gEfiDiskInfoUsbInterfaceGuid                  ## SOMETIMES_CONSUMES
  gEfiDiskInfoScsiInterfaceGuid                 ## SOMETIMES_CONSUMES
  gEfiEventReadyToBootGuid                      ## CONSUMES ## Event

[Pcd]
  gRpiBmcTokenSpaceGuid.PcdBmcEepromBlkInfoOffset   ## CONSUMES
  gRpiBmcTokenSpaceGuid.PcdBmcEepromBlkInfoSize     ## CONSUMES

[Depex]
  TRUE
