## @file
#
#  BootloaderConfigDxe - publish the VPU bootloader EEPROM config
#  (blconfig nvmem-rmem region) as the BootloaderConfig UEFI variable,
#  gated on /chosen/bootloader/update-timestamp, and provide the
#  "Bootloader EEPROM" Setup page that can stage a pieeprom.upd
#  self-update on the boot partition (reading the live image back over
#  the boot SPI) and reboot to apply it.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
##

[Defines]
  INF_VERSION                    = 0x0001001A
  BASE_NAME                      = BootloaderConfigDxe
  FILE_GUID                      = 195722bb-52f4-4a4c-b09f-61e13007a1e6
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BootloaderConfigEntryPoint

[Sources]
  Bcm2712SpiFlash.c
  Bcm2712SpiFlash.h
  BlcfgValues.c
  BootloaderConfig.h
  BootloaderConfigDxe.c
  BootloaderConfigDxe.uni
  BootloaderConfigDxeMap.uni
  BootloaderConfigSetup.c
  BootloaderConfigHii.vfr
  EepromImage.c
  EepromImage.h
  Sha256.c
  Sha256.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  RpiBmcPkg/RpiBmcPkg.dec
  Platform/RaspberryPi/RaspberryPi.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  FdtLib
  HiiLib
  IoLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiHiiServicesLib
  UefiLib
  UefiRuntimeServicesTableLib

[Protocols]
  gEfiVariableWriteArchProtocolGuid             ## CONSUMES
  gEfiDevicePathProtocolGuid                    ## PRODUCES
  gEfiHiiConfigAccessProtocolGuid               ## PRODUCES
  gEfiSimpleFileSystemProtocolGuid              ## SOMETIMES_CONSUMES

[Guids]
  gRpiBmcBootloaderVendorGuid                   ## PRODUCES ## Variable:L"BootloaderConfig"
  gRpiBlCfgFormSetGuid                          ## PRODUCES ## Variable:L"BlCfg"
  gEfiHiiPlatformSetupFormsetGuid               ## CONSUMES ## GUID
  gEfiEventReadyToBootGuid                      ## CONSUMES ## Event

[FixedPcd]
  gRaspberryPiTokenSpaceGuid.PcdFdtBaseAddress  ## CONSUMES

[Depex]
  gEfiVariableArchProtocolGuid AND gEfiVariableWriteArchProtocolGuid
