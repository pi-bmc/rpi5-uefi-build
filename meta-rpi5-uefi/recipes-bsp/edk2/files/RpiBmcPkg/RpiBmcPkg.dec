#/** @file
#
#  RpiBmcPkg - Raspberry Pi 5 board drivers for the pi-bmc project.
#
#  Out-of-tree package: added to PACKAGES_PATH by meta-rpi5-uefi's
#  edk2-rpi5-firmware recipe, never merged into edk2-platforms. Carries the
#  board-integration drivers with no upstream home: the power button, the
#  active-cooler fan, and the bootloader-provenance UEFI variables.
#
#  The I2C shared-EEPROM sync stack that used to live here (Rp1DwI2cDxe,
#  BmcEepromLib, EepromVarStoreDxe, SmbiosEepromMirrorDxe, BlkInfoMirrorDxe)
#  was replaced by the Redfish Host Interface over the BMC's USB CDC-NCM
#  gadget - see RpiRedfishPkg for the successor and its wire contract.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
#
#**/

[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = RpiBmcPkg
  PACKAGE_GUID                   = acc8be70-94ea-4101-9fb0-3e44f81360ba
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[LibraryClasses]
  ##  @libraryclass  Stateless MMIO helpers for the RP1 GPIO banks
  ##                 (io_bank / sys_rio / pads windows).
  Rp1GpioLib|Include/Library/Rp1GpioLib.h

[Guids]
  gRpiBmcTokenSpaceGuid = { 0xd40c55e2, 0x13df, 0x4d9e, { 0x81, 0x52, 0xb0, 0x90, 0x89, 0x1a, 0x19, 0xd2 } }

  ## Vendor GUID of the BootloaderConfig / BootloaderUpdateTimestamp UEFI
  ## variables. Frozen contract - mirrored by u-boot rpi.c
  ## (rpi_bootloader_guid) and the BMC's efivars package. Do not change.
  gRpiBmcBootloaderVendorGuid = { 0xd1a0f2c4, 0x9b3e, 0x4f7a, { 0x8c, 0x21, 0x6e, 0x5b, 0x0a, 0x7d, 0x4f, 0x10 } }

  ## Vendor GUID of the FanPolicy variable and FanConfigDxe's Setup formset
  ## (Include/Guid/RpiFanPolicy.h).
  gRpiFanConfigFormSetGuid = { 0x6c2b9f4a, 0xe0d3, 0x4f8b, { 0x84, 0x59, 0xa2, 0x0f, 0x6d, 0x4e, 0x91, 0xc7 } }

  ## Vendor GUID of the BlCfg / BlCfgStaged variables and
  ## BootloaderConfigDxe's Setup formset (Include/Guid/RpiBlCfg.h).
  gRpiBlCfgFormSetGuid = { 0x8f3a5c12, 0x6b4d, 0x4e2a, { 0x9d, 0x07, 0x4b, 0xaa, 0x1c, 0x86, 0x33, 0xf5 } }

[Protocols]
  ## Active-cooler control surface produced by ActiveCoolerDxe
  ## (Include/Protocol/RpiFan.h).
  gRpiFanProtocolGuid = { 0x9d8a2c6e, 0x41b7, 0x4c15, { 0x9e, 0x02, 0x7a, 0x33, 0xd1, 0x5f, 0x28, 0x64 } }
