+  if (EFI_ERROR (Status)) {
+    DEBUG ((
+      DEBUG_ERROR,
+      "RP1: Failed to register the ExitBootServices handler. Status=%r\n",
+      Status
+      ));
+  }
+
   return EFI_SUCCESS;
 
