diff --git a/Silicon/RaspberryPi/RpiSiliconPkg/Include/Rp1.asi b/Silicon/RaspberryPi/RpiSiliconPkg/Include/Rp1.asi
--- a/Silicon/RaspberryPi/RpiSiliconPkg/Include/Rp1.asi
+++ b/Silicon/RaspberryPi/RpiSiliconPkg/Include/Rp1.asi
@@ -73,3 +73,69 @@
     Return (RBUF)
   }
 }
+
+//
+// RP1 Cadence GEM_GXL Gigabit Ethernet -- the Pi 5's onboard NIC, the same
+// block Rp1BusDxe hands to Rp1GemDxe as gRp1GemNonDiscoverableDeviceGuid.
+//
+// There is no standard ACPI _HID for a Cadence GEM, and Linux's macb driver
+// (drivers/net/ethernet/cadence/macb_main.c) publishes only an of_match_table
+// -- neither mainline nor raspberrypi/linux gives it an acpi_match_table. The
+// one mechanism that binds it from ACPI is _HID "PRP0001", which makes
+// acpi_driver_match_device() fall through to acpi_of_match_device() and match
+// the _DSD "compatible" property against that of_match_table.
+//
+// Matching is necessary but NOT sufficient on a stock kernel: macb_probe()
+// goes on to call macb_clk_init_dflt(), which hard-requires "pclk" and "hclk"
+// through devm_clk_get(), and clkdev has no ACPI path at all (clk_get() looks
+// at dev->of_node and then the clkdev list, nothing else). Probe therefore
+// still ends at "failed to get pclk", and SystemTableMode=DeviceTree stays the
+// working path, until the driver treats those clocks as optional when there is
+// no of_node. That is the right fix for RP1, whose clock tree the VideoCore
+// firmware has already programmed -- the same reason Rp1GemDxe needs no clock
+// driver of its own.
+//
+// Everything the firmware side can get right is right here, so nothing but a
+// driver-side change is left:
+//   - one 0x4000 register window at RP1_ETH_BASE and one shared level
+//     interrupt, exactly as rp1.dtsi describes the node. eth_cfg at
+//     RP1_ETH_CFG_BASE is deliberately absent, as it is from the DT node: the
+//     firmware owns the RGMII mux and Rp1GemDxe is its only consumer.
+//   - the "cdns,*" AMP tuning properties, which raspberrypi/linux reads with
+//     the fwnode-generic device_property_read_*() helpers and so picks up from
+//     _DSD unchanged.
+//   - _CCA, inherited from RP1B (acpi_init_coherency() propagates a parent's
+//     when the child has none), matching the DT's non-coherent DMA.
+//
+// The station address needs no property: Rp1GemDxe leaves it in the GEM's
+// SA1B/SA1T registers -- its ExitBootServices hook only clears NET_CTRL --
+// which is where macb_get_hwaddr() looks when no fwnode address is found.
+//
+// Windows has no driver for this block and will show ACPI\PRP0001 as an
+// unknown device, the same as it would for any other OF-described peripheral.
+//
+Device (ETH0) {
+  Name (_HID, "PRP0001")
+  Name (_UID, 0x0)
+
+  Method (_CRS, 0, Serialized) {
+    Name (RBUF, ResourceTemplate () {
+      RP1_QWORDMEMORY_BUF (00)
+      RP1_INTERRUPT_BUF (01)
+    })
+    RP1_QWORDMEMORY_SET (00, RP1_ETH_BASE, RP1_ETH_SIZE)
+    RP1_INTERRUPT_SET (01)
+    Return (RBUF)
+  }
+
+  Name (_DSD, Package () {
+    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
+    Package () {
+      Package (2) { "compatible", Package (2) { "raspberrypi,rp1-gem", "cdns,macb" } },
+      Package (2) { "phy-mode", "rgmii-id" },
+      Package (2) { "cdns,aw2w-max-pipe", 8 },
+      Package (2) { "cdns,ar2r-max-pipe", 8 },
+      Package (2) { "cdns,use-aw2b-fill", 1 }
+    }
+  })
+}
