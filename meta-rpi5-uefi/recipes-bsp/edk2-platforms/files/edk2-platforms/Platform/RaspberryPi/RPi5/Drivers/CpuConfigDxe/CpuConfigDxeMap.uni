/** @file
 *
 *  Redfish configure-language map for the CPU clock formset.
 *
 *  Two namespaces, deliberately:
 *
 *  The speed questions carry the standard Processor schema language and
 *  are served as /redfish/v1/Systems/1/Processors/{id} properties by
 *  RedfishProcessorDxe + RedfishProcessorCollectionDxe - the BMC caps
 *  the CPU with a plain Redfish PATCH of SpeedLimitMHz/SpeedLocked, no
 *  vendor attributes involved. Configure language is rooted at the
 *  schema (/Processors/{1}/...), and the version here must match the
 *  feature driver's RESOURCE_SCHEMA_FULL byte for byte or every
 *  property silently fails to resolve.
 *
 *  The over-voltage delta has no Processor-schema counterpart and stays
 *  a BIOS attribute in the Bios.v1_1_0 namespace, published by the Bios
 *  feature driver with its allowable range in the BiosAttributeRegistry.
 *
 *  The apply action and the "Configured in config.txt" text are
 *  deliberately unmapped.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

/=#
#langdef   x-UEFI-redfish-Processor.v1_14_0 "Processor.v1_14_0"

#string STR_LIMIT_PROMPT   #language x-UEFI-redfish-Processor.v1_14_0   "/Processors/{1}/SpeedLimitMHz"
#string STR_LOCKED_PROMPT  #language x-UEFI-redfish-Processor.v1_14_0   "/Processors/{1}/SpeedLocked"

#langdef   x-UEFI-redfish-Bios.v1_1_0 "Bios.v1_1_0"

#string STR_DELTA_PROMPT   #language x-UEFI-redfish-Bios.v1_1_0   "/Bios/Attributes/CpuOverVoltageDeltaUv"
