[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = RPi5
  PACKAGE_GUID                   = d4f34c69-5f19-4dbc-a4cb-02163197e35e
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[Guids]
  gRpiPlatformFormSetGuid = { 0x677a7ac5, 0x7d92, 0x4288, { 0x8b, 0xf0, 0x97, 0x04, 0x81, 0x02, 0xd1, 0x1c } }

  ## Vendor GUID of the bootloader-provenance UEFI variables BootloaderConfigDxe
  #  publishes for the BMC (see Include/RpiBmcEeprom.h).
  gRpiBmcBootloaderVendorGuid = { 0xd1a0f2c4, 0x9b3e, 0x4f7a, { 0x8c, 0x21, 0x6e, 0x5b, 0x0a, 0x7d, 0x4f, 0x10 } }

  ## HII formset GUIDs of the board's own Setup pages.
  gRpiFanConfigFormSetGuid = { 0x6c2b9f4a, 0xe0d3, 0x4f8b, { 0x84, 0x59, 0xa2, 0x0f, 0x6d, 0x4e, 0x91, 0xc7 } }
  gRpiBlCfgFormSetGuid     = { 0x8f3a5c12, 0x6b4d, 0x4e2a, { 0x9d, 0x07, 0x4b, 0xaa, 0x1c, 0x86, 0x33, 0xf5 } }

  ## Token spaces inherited from the retired RpiRedfishPkg and RpiFmpPkg .dec
  #  files, whose contents were board-scoped and so belong here.
  gRpiRedfishTokenSpaceGuid = { 0x7c3e8f52, 0x1b9a, 0x4d07, { 0xa6, 0x54, 0x2e, 0x91, 0xc8, 0x3f, 0x7b, 0x24 } }
  gRpiFmpTokenSpaceGuid     = { 0x62075a6a, 0xc3dd, 0x4b7d, { 0xa1, 0x18, 0x4b, 0x72, 0xe0, 0x47, 0x57, 0xfc } }

[Protocols]
  ## Fan speed/policy control published by ActiveCoolerDxe and consumed by
  #  FanConfigDxe's Setup page.
  gRpiFanProtocolGuid = { 0x9d8a2c6e, 0x41b7, 0x4c15, { 0x9e, 0x02, 0x7a, 0x33, 0xd1, 0x5f, 0x28, 0x64 } }

[PcdsFeatureFlag]
  gRpiFmpTokenSpaceGuid.PcdRpi5FmpUpdateSupported|TRUE|BOOLEAN|0x00000002

[PcdsFixedAtBuild]
  ## The Redfish host-interface wire contract with the BMC. The defaults here
  #  are the contract's documented values; the firmware recipe
  #  overrides the MAC and the credentials from its own knobs.
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetMac|{0xDA, 0xC0, 0xFF, 0xEE, 0x10, 0x02}|VOID*|0x00000001

  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishHostIp|{0xA9, 0xFE, 0x0A, 0x02}|VOID*|0x00000002
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishServiceIp|{0xA9, 0xFE, 0x0A, 0x01}|VOID*|0x00000003
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishIpMask|{0xFF, 0xFF, 0x00, 0x00}|VOID*|0x00000004

  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetVendorId|0x1D6B|UINT16|0x00000005
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishGadgetProductId|0x0104|UINT16|0x00000006

  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishUser|"admin"|VOID*|0x00000007
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishPassword|"admin"|VOID*|0x00000008

  ## Integer firmware version FmpDeviceGetVersion reports and ESRT publishes.
  #  The recipe overrides it from RPI5_FMP_VERSION.
  gRpiFmpTokenSpaceGuid.PcdRpi5FirmwareVersion|202602|UINT32|0x00000001
