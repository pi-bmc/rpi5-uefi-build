/** @file
 *
 *  CPU clock formset, bound to the CpuClockPolicy variable (efivarstore -
 *  the browser and the Redfish Processor pipeline read and write the
 *  variable directly). The questions mirror the Processor schema:
 *  SpeedLimitMHz (0 = no override, else the arm_freq cap) and SpeedLocked
 *  (force_turbo). The over-voltage delta stays a BIOS attribute.
 *
 *  The apply action rewrites config.txt immediately and offers a reset;
 *  without it, the ReadyToBoot reconvergence picks the variable up on the
 *  next boot.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

#include <Guid/HiiPlatformSetupFormset.h>
#include <Guid/RpiCpuClockPolicy.h>

#define EFI_VARIABLE_NON_VOLATILE       0x00000001
#define EFI_VARIABLE_BOOTSERVICE_ACCESS 0x00000002
#define EFI_VARIABLE_RUNTIME_ACCESS     0x00000004

formset
    guid      = RPI_CPU_CONFIG_FORMSET_GUID,
    title     = STRING_TOKEN(STR_FORM_SET_TITLE),
    help      = STRING_TOKEN(STR_FORM_SET_TITLE_HELP),
    classguid = EFI_HII_PLATFORM_SETUP_FORMSET_GUID,

    efivarstore RPI_CPU_CLOCK_POLICY,
      attribute = EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS | EFI_VARIABLE_NON_VOLATILE,
      name  = CpuClockPolicy,
      guid  = RPI_CPU_CONFIG_FORMSET_GUID;

    form formid = 1,
        title = STRING_TOKEN(STR_FORM_TITLE);

        text
            help   = STRING_TOKEN(STR_CONFIGURED_HELP),
            text   = STRING_TOKEN(STR_CONFIGURED_PROMPT),
            text   = STRING_TOKEN(STR_CONFIGURED_VALUE);

        numeric varid = CpuClockPolicy.SpeedLimitMhz,
            prompt  = STRING_TOKEN(STR_LIMIT_PROMPT),
            help    = STRING_TOKEN(STR_LIMIT_HELP),
            flags   = NUMERIC_SIZE_2 | DISPLAY_UINT_DEC | RESET_REQUIRED,
            minimum = 0,
            maximum = 3000,
            step    = 100,
            default = 0,
        endnumeric;

        suppressif ideqval CpuClockPolicy.SpeedLimitMhz == 0;
            checkbox varid = CpuClockPolicy.SpeedLocked,
                prompt = STRING_TOKEN(STR_LOCKED_PROMPT),
                help   = STRING_TOKEN(STR_LOCKED_HELP),
                flags  = CHECKBOX_DEFAULT | RESET_REQUIRED,
            endcheckbox;

            numeric varid = CpuClockPolicy.OverVoltageDeltaUv,
                prompt  = STRING_TOKEN(STR_DELTA_PROMPT),
                help    = STRING_TOKEN(STR_DELTA_HELP),
                flags   = NUMERIC_SIZE_4 | DISPLAY_UINT_DEC | RESET_REQUIRED,
                minimum = 0,
                maximum = 100000,
                step    = 5000,
                default = 50000,
            endnumeric;
        endif;

        subtitle text = STRING_TOKEN(STR_WARNING_1);
        subtitle text = STRING_TOKEN(STR_WARNING_2);

        text
            help   = STRING_TOKEN(STR_APPLY_HELP),
            text   = STRING_TOKEN(STR_APPLY_PROMPT),
            flags  = INTERACTIVE,
            key    = RPI_CPU_CLOCK_KEY_APPLY;

    endform;

endformset;
