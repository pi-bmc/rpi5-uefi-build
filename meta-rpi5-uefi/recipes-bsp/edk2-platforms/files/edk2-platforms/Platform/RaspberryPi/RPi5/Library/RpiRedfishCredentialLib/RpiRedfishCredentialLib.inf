## @file
#  RpiRedfishCredentialLib - RedfishPlatformCredentialLib instance reporting
#  HTTP Basic credentials (from RpiRedfishPkg PCDs) for the nanokvm BMC's
#  Redfish service; AuthMethodNone when no user is configured.
#
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x0001001B
  BASE_NAME      = RpiRedfishCredentialLib
  FILE_GUID      = 4d82c6f1-7b3a-4e58-b0c9-8f25d1a94e67
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 1.0
  LIBRARY_CLASS  = RedfishPlatformCredentialLib|DXE_DRIVER

[Sources]
  RpiRedfishCredentialLib.c

[Packages]
  MdePkg/MdePkg.dec
  RedfishPkg/RedfishPkg.dec
  Platform/RaspberryPi/RPi5/RPi5.dec

[LibraryClasses]
  BaseLib
  DebugLib
  MemoryAllocationLib
  PcdLib

[FixedPcd]
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishUser      ## CONSUMES
  gRpiRedfishTokenSpaceGuid.PcdRpiRedfishPassword  ## CONSUMES
