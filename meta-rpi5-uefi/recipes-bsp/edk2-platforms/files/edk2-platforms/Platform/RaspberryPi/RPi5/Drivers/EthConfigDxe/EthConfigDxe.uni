#langdef en-US "English"

#string STR_FORM_SET_TITLE              #language en-US "IPv4 (BMC Managed)"
#string STR_FORM_SET_TITLE_HELP         #language en-US "BMC-managed IPv4 policy for the onboard Ethernet port. These settings are pushed into the network stack on every boot and override anything configured on the standard IPv4 Network Configuration page. The BMC edits them over standard Redfish (/Systems/1/EthernetInterfaces)."
#string STR_FORM_TITLE                  #language en-US "BMC-Managed IPv4 Configuration"

#string STR_ETH_MAC_PROMPT              #language en-US "MAC Address"
#string STR_ETH_MAC_HELP                #language en-US "The onboard NIC's MAC address (read-only, refreshed each boot)."

#string STR_ETH_DHCP_PROMPT             #language en-US "Obtain Address via DHCP"
#string STR_ETH_DHCP_HELP               #language en-US "Checked (default): the DHCP policy is applied on every boot. Unchecked: the static settings below are applied instead; if the static address is left empty, the NIC's own IPv4 configuration is not touched. Changes apply on the next boot."

#string STR_ETH_IP4_ADDRESS_PROMPT      #language en-US "Static IP Address"
#string STR_ETH_IP4_SUBNET_MASK_PROMPT  #language en-US "Subnet Mask"
#string STR_ETH_IP4_GATEWAY_PROMPT      #language en-US "Default Gateway"
#string STR_ETH_IP4_DNS1_PROMPT         #language en-US "DNS Server 1"
#string STR_ETH_IP4_DNS2_PROMPT         #language en-US "DNS Server 2"
#string STR_ETH_IP4_REQUIRED_HELP       #language en-US "Dotted-quad IPv4 address, e.g. 192.168.1.10. Required for a static configuration: if this or the subnet mask does not parse, the boot keeps the NIC's existing configuration."
#string STR_ETH_IP4_OPTIONAL_HELP       #language en-US "Dotted-quad IPv4 address. Optional: leave empty to omit."
