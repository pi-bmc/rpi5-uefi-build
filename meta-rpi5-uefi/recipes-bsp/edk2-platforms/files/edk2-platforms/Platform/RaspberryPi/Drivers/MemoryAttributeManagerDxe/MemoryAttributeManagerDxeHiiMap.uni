/** @file
 *
 *  x-UEFI-redfish configure-language map for the EFI Memory Attribute
 *  Protocol formset.
 *
 *  RedfishPlatformConfigDxe harvests these strings from the HII database:
 *  the question prompt labeled in the x-UEFI-redfish-Bios.v1_1_0 language
 *  becomes a BIOS attribute at /redfish/v1/Systems/1/Bios (published by
 *  the edk2-redfish-client Bios v1_1_0 feature driver, with its allowable
 *  values in the BiosAttributeRegistry), named by the last segment of the
 *  configure-language path.
 *
 *  Boolean attribute, backed by the MemoryAttributeManagerData
 *  efivarstore, RESET_REQUIRED - a BMC write lands in the same variable
 *  the Setup page edits and takes effect on the following boot.
 *
 *  SPDX-License-Identifier: BSD-2-Clause-Patent
 *
 **/

/=#
#langdef   x-UEFI-redfish-Bios.v1_1_0 "Bios.v1_1_0"

#string STR_ENABLE_PROTOCOL_PROMPT   #language x-UEFI-redfish-Bios.v1_1_0   "/Bios/Attributes/MemoryAttributeProtocol"
