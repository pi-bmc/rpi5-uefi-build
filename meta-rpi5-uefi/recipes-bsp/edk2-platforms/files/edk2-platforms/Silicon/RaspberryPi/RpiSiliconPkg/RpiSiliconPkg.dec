[Defines]
  DEC_SPECIFICATION              = 0x0001001A
  PACKAGE_NAME                   = RpiSiliconPkg
  PACKAGE_GUID                   = 6dd4364e-9b8a-449e-b0a7-60095c5a0f15
  PACKAGE_VERSION                = 1.0

[Includes]
  Include

[LibraryClasses]
  ##  @libraryclass  Direct access to the RP1 southbridge's GPIO block: pad
  #                  control, function select and the PWM used by the Pi 5
  #                  Active Cooler. Consumed by Rp1GemDxe (PHY reset) and by
  #                  the board's ActiveCoolerDxe.
  Rp1GpioLib|Include/Library/Rp1GpioLib.h

[Guids]
  gRpiSiliconTokenSpaceGuid = { 0x0b3ce57a, 0xa82b, 0x4ada, { 0x8f, 0xb5, 0x52, 0xc8, 0x72, 0x30, 0x1f, 0xdb } }

  ## NON_DISCOVERABLE_DEVICE type GUIDs for RP1 peripherals registered by
  ## Rp1BusDxe that have no generic EDK2 device class.
  gRp1GemNonDiscoverableDeviceGuid = { 0x9c1ca504, 0xcdc9, 0x43bb, { 0xa1, 0x32, 0x67, 0x55, 0x59, 0x6d, 0x3a, 0x56 } }
  gRp1DwI2cNonDiscoverableDeviceGuid = { 0x9af3f93f, 0xcc1c, 0x443c, { 0x99, 0xe8, 0x2e, 0xa4, 0x54, 0x7b, 0x2b, 0x6a } }

[Protocols]
  gRp1BusProtocolGuid = { 0xf1417a30, 0x5418, 0x4cd5, { 0x8e, 0x65, 0xf9, 0x02, 0x51, 0x21, 0xb5, 0x7f } }
