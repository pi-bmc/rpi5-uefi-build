From: appkins <nbatkins@gmail.com>
Date: Sat, 22 Aug 2026 20:20:00 -0500
Subject: [PATCH] PlatformBm: connect USB NICs after boot option enumeration

This is the platform half of the USB NIC gate (edk2 recipe patch 0108,
which teaches NetworkCommon to refuse to bind until the gate protocol
exists). Install the gate and connect the USB Ethernet handles at the
end of PlatformBootManagerAfterConsole, once boot option enumeration is
behind us, so the Redfish host interface stack assembles during the boot
timeout countdown - waiting the firmware was doing anyway - instead of
preempting enumeration from TPL_CALLBACK/TPL_NOTIFY callbacks the whole
way through.

Moving the stack's bring-up out of ConnectAll removes the accidental
serialization that used to guarantee RpiRedfishSyncDxe's exchange - and
any boot override the BMC staged - completed before the boot selection.
So the boot now waits for it deliberately instead: once the NIC is
connected, and only when the Redfish config handler protocol exists (the
Redfish stack is a build-time option), BDS holds in a stall loop until
RpiRedfishSyncDxe installs its sync-settled signal, bounded at 20 s for
a BMC whose Redfish service never answers. The exchange runs from timer
and protocol-notify callbacks, which preempt the TPL_APPLICATION stall
loop freely - waiting here is what lets it run. An applied override
never returns (BootNext + cold reset); every other outcome signals.

The USB host controllers are connected first: under BDP_CONNECT_MINIMAL
(this platform's default Boot Discovery Policy) nothing else has
enumerated the bus by this point, so the CDC class driver has not
produced the USB Ethernet handles yet. That also makes the Redfish host
interface independent of the policy knob: the management NIC now
connects on every boot, deterministically, rather than as a side effect
of whichever discovery policy the variable happens to hold, and the
policy goes back to governing boot device discovery only.

Also drop a duplicated BootDiscoveryPolicyHandler() call: the handler
ran twice back to back, and at BDP_CONNECT_NET/ALL each run repeats the
full ConnectDeviceClass walk - enumeration paid for it twice.

Upstream-Status: Inappropriate [platform boot policy]
Signed-off-by: appkins <nbatkins@gmail.com>
---
--- a/Platform/RaspberryPi/Library/PlatformBootManagerLib/PlatformBm.c
+++ b/Platform/RaspberryPi/Library/PlatformBootManagerLib/PlatformBm.c
@@ -854,6 +854,158 @@
   EfiBootManagerFreeLoadOptions (Options, OptionCount);
 }
 
+//
+// Gate under which NetworkCommon (the UsbNetworkPkg UNDI driver) agrees to
+// bind a USB NIC; installing it is the platform saying "now". The GUID
+// literal is duplicated in the edk2 tree's NetworkCommon (see the
+// 0108-NetworkCommon patch in the edk2 recipe); keep the two in sync.
+//
+STATIC CONST EFI_GUID mUsbNicGateGuid =
+  { 0x5144a8c6, 0x4d1c, 0x4709, { 0xb3, 0xa6, 0xfc, 0xb7, 0x44, 0xc3, 0x60, 0xdc } };
+
+//
+// Installed by RpiRedfishSyncDxe once its first BMC exchange has run to
+// completion, whatever the outcome. The GUID literal is duplicated there;
+// keep the two in sync.
+//
+STATIC CONST EFI_GUID mRpiRedfishSyncSettledGuid =
+  { 0x47a80c52, 0x948f, 0x4972, { 0x81, 0xe1, 0x6b, 0x32, 0x32, 0x4b, 0x06, 0x08 } };
+
+//
+// Upper bound on the wait for that signal, in 100 ms polls. The exchange
+// normally settles in a few seconds; the bound only bites when the BMC's
+// Redfish service is unreachable, where it trades up to 20 s of boot time
+// for never missing a staged boot override. Only paid when a USB NIC and
+// the Redfish config handler both exist.
+//
+#define RPI_SYNC_WAIT_POLLS  200
+
+/**
+  Connect the USB NICs now that boot option enumeration is over.
+
+  NetworkCommon refuses to bind while mUsbNicGateGuid is absent, so the
+  BMC's CDC gadget NIC - the Redfish host interface - sits out the
+  connect-all that feeds boot option enumeration. Without the gate the NIC
+  binds mid-enumeration, the whole Redfish stack (discovery, config
+  handlers, RpiRedfishSyncDxe's HTTP exchange) springs to life from
+  protocol-notify callbacks, and - TPL being strictly priority-scheduled -
+  BDS at TPL_APPLICATION only runs when all of it drains. Behind the DWC2
+  USB-C controller, where every transfer is a TPL_NOTIFY busy-wait, that
+  turned enumeration into a crawl.
+
+  Opening the gate here instead lets the Redfish stack come up during the
+  boot-timeout countdown, overlapping waiting the firmware was doing
+  anyway. It also decouples the Redfish host interface from the Boot
+  Discovery Policy: the NIC connects on every boot even at
+  BDP_CONNECT_MINIMAL, and that knob goes back to governing boot device
+  discovery only.
+
+  The USB host controllers are connected first: under BDP_CONNECT_MINIMAL
+  nothing else has enumerated the bus, so the CDC class driver has not
+  produced the USB Ethernet handles yet.
+
+  @retval TRUE   At least one USB NIC handle was found and connected.
+  @retval FALSE  No USB NIC is present (or the gate could not be installed).
+**/
+STATIC
+BOOLEAN
+ConnectUsbNicDevices (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  GateHandle;
+  EFI_HANDLE  *Handles;
+  UINTN       Count;
+  UINTN       Index;
+
+  GateHandle = NULL;
+  Status = gBS->InstallProtocolInterface (&GateHandle,
+                  (EFI_GUID *)&mUsbNicGateGuid, EFI_NATIVE_INTERFACE, NULL);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: install USB NIC gate: %r\n",
+      __func__, Status));
+    return FALSE;
+  }
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEfiUsb2HcProtocolGuid,
+                  NULL, &Count, &Handles);
+  if (!EFI_ERROR (Status)) {
+    for (Index = 0; Index < Count; Index++) {
+      gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+    }
+
+    FreePool (Handles);
+  }
+
+  Status = gBS->LocateHandleBuffer (ByProtocol, &gEdkIIUsbEthProtocolGuid,
+                  NULL, &Count, &Handles);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_INFO, "%a: no USB NIC present (%r)\n", __func__, Status));
+    return FALSE;
+  }
+
+  for (Index = 0; Index < Count; Index++) {
+    gBS->ConnectController (Handles[Index], NULL, NULL, TRUE);
+  }
+
+  FreePool (Handles);
+  return TRUE;
+}
+
+/**
+  Hold the boot until the Redfish host interface sync has settled, bounded.
+
+  The gate above moved the Redfish stack's bring-up out of ConnectAll, so
+  nothing else serializes RpiRedfishSyncDxe's exchange - which consumes any
+  boot override the BMC staged - against the boot selection. Without this
+  wait a fast default boot reaches ExitBootServices first, the Redfish
+  quiesce stops the stack, and the override sits unconsumed on the BMC.
+
+  Discovery, the exchange and its retries all run from timer and
+  protocol-notify callbacks, which preempt this TPL_APPLICATION stall loop
+  freely - waiting here IS letting them run. An applied override never
+  returns (BootNext + cold reset); every other outcome installs the settled
+  signal. The bound covers a BMC whose Redfish service never answers:
+  RpiRedfishSyncDxe can only signal once discovery hands it a service.
+**/
+STATIC
+VOID
+WaitForRedfishSyncSettled (
+  VOID
+  )
+{
+  VOID   *Instance;
+  UINTN  Poll;
+
+  //
+  // Redfish is a build-time option; without its config handler protocol
+  // (installed by RpiRedfishSyncDxe at dispatch) there is nothing to wait
+  // for.
+  //
+  if (EFI_ERROR (gBS->LocateProtocol (
+                        &gEdkIIRedfishConfigHandlerProtocolGuid,
+                        NULL, &Instance))) {
+    return;
+  }
+
+  for (Poll = 0; Poll < RPI_SYNC_WAIT_POLLS; Poll++) {
+    if (!EFI_ERROR (gBS->LocateProtocol (
+                          (EFI_GUID *)&mRpiRedfishSyncSettledGuid,
+                          NULL, &Instance))) {
+      DEBUG ((DEBUG_INFO, "%a: Redfish sync settled after ~%dms\n",
+        __func__, Poll * 100));
+      return;
+    }
+
+    gBS->Stall (100 * 1000);
+  }
+
+  DEBUG ((DEBUG_ERROR,
+    "%a: Redfish sync did not settle within ~%dms, booting on\n",
+    __func__, RPI_SYNC_WAIT_POLLS * 100));
+}
+
 /**
   Do the platform specific action after the console is ready
   Possible things that can be done in PlatformBootManagerAfterConsole:
@@ -895,11 +1047,6 @@
     DEBUG ((DEBUG_INFO, "Error applying Boot Discovery Policy:%r\n", Status));
   }
 
-  Status = BootDiscoveryPolicyHandler ();
-  if (EFI_ERROR(Status)) {
-    DEBUG ((DEBUG_INFO, "Error applying Boot Discovery Policy:%r\n", Status));
-  }
-
   Status = gBS->LocateProtocol (&gEsrtManagementProtocolGuid, NULL, (VOID**)&EsrtManagement);
   if (!EFI_ERROR (Status)) {
     EsrtManagement->SyncEsrtFmp ();
@@ -912,6 +1059,10 @@
   }
 
   PlatformRegisterOptionsAndKeys ();
+
+  if (ConnectUsbNicDevices ()) {
+    WaitForRedfishSyncSettled ();
+  }
 }
 
 /**
--- a/Platform/RaspberryPi/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
+++ b/Platform/RaspberryPi/Library/PlatformBootManagerLib/PlatformBootManagerLib.inf
@@ -31,6 +31,7 @@
 [Packages]
   MdeModulePkg/MdeModulePkg.dec
   MdePkg/MdePkg.dec
+  RedfishPkg/RedfishPkg.dec
   ShellPkg/ShellPkg.dec
   Platform/RaspberryPi/RaspberryPi.dec
 
@@ -86,6 +87,8 @@
   gEfiSimpleFileSystemProtocolGuid
   gEsrtManagementProtocolGuid
   gEfiUsb2HcProtocolGuid
+  gEdkIIUsbEthProtocolGuid
+  gEdkIIRedfishConfigHandlerProtocolGuid
 
 [Depex]
   gEdkiiPlatformSpecificResetHandlerProtocolGuid
