@@ -1832,6 +2187,12 @@
     gBS->CloseEvent (DwHc->ExitBootServiceEvent);
   }
 
+  if (DwHc->Pump.Buffer != NULL) {
+    DmaUnmap (DwHc->Pump.BufferMapping);
+    DmaFreeBuffer (EFI_SIZE_TO_PAGES (DWC2_DATA_BUF_SIZE), DwHc->Pump.Buffer);
