+  DwHcPumpHalt (DwHc);
+
   if (DwHc->PeriodicEvent != NULL) {
     EFI_TPL PreviousTpl;
     PreviousTpl = gBS->RaiseTPL (TPL_NOTIFY);
--- a/Platform/RaspberryPi/Drivers/DwUsbHostDxe/DwUsbHostDxe.h
+++ b/Platform/RaspberryPi/Drivers/DwUsbHostDxe/DwUsbHostDxe.h
@@ -94,6 +94,39 @@
   IN     UINTN                              TimeOut;
 } DWUSB_DEFERRED_REQ;
 
+typedef enum {
+  DwUsbPumpIdle = 0,
+  DwUsbPumpArmed,
+  DwUsbPumpReady
+} DWUSB_PUMP_STATE;
+
+/*
+ * A standing bulk IN request executed autonomously by an otherwise unused
+ * host channel, so polled receives (the USB network class drivers' idiom)
+ * are served from memory instead of busy-waiting at TPL_NOTIFY while the
+ * core NAK-retries on the wire. See DwHcPumpBulkIn.
+ */
+typedef struct {
+  DWUSB_PUMP_STATE                State;
+  UINT8                           DeviceAddress;
+  UINT8                           EpAddress;
+  UINT8                           DeviceSpeed;
+  UINTN                           MaximumPacketLength;
+  /*
+   * HCTSIZ PID encoding of the next expected data toggle. The hardware
+   * owns the endpoint's toggle while the pump runs; this mirrors it back
+   * to the caller's DataToggle on every delivery.
+   */
+  UINT32                          Pid;
+  UINT32                          ArmedLength;
+  UINT32                          ReadyLength;
+  UINT32                          Errors;
+  UINT32                          Cooldown;
+  UINT8                           *Buffer;
+  VOID                            *BufferMapping;
+  UINTN                           BufferBusAddress;
+} DWUSB_PUMP;
+
 typedef struct _DWUSB_OTGHC_DEV {
   UINTN                           Signature;
 
@@ -127,6 +160,8 @@
    * 125us frames;
    */
   UINT16                          LastMicroFrame;
+
+  DWUSB_PUMP                      Pump;
 } DWUSB_OTGHC_DEV;
 
 extern EFI_COMPONENT_NAME_PROTOCOL  gComponentName;
