+/**
+  Try to load a device tree from one filesystem and hand it to the OS.
+
+  @param  Handle[in]  A handle carrying EFI_SIMPLE_FILE_SYSTEM_PROTOCOL.
+  @param  Path[in]    Where on that volume to look.
+
+  @retval EFI_SUCCESS  A tree was loaded, fixed up and installed.
+  @retval other        This volume has none, or it could not be used.
+
+**/
+STATIC
+EFI_STATUS
+TryLoadFdtFromVolume (
+  IN EFI_HANDLE    Handle,
+  IN CONST CHAR16  *Path
+  )
+{
+  EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs;
+  EFI_FILE_PROTOCOL                *Root;
+  EFI_FILE_PROTOCOL                *File;
+  EFI_FILE_INFO                    *Info;
+  EFI_STATUS                       Status;
+  EFI_PHYSICAL_ADDRESS             Buffer;
+  UINTN                            InfoSize;
+  UINTN                            FileSize;
+  UINTN                            BufferSize;
+  UINTN                            Pages;
+
+  Root   = NULL;
+  File   = NULL;
+  Info   = NULL;
+  Buffer = 0;
+  Pages  = 0;
+
+  Status = gBS->HandleProtocol (Handle, &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = Fs->OpenVolume (Fs, &Root);
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = Root->Open (Root, &File, (CHAR16 *)Path, EFI_FILE_MODE_READ, 0);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  InfoSize = 0;
+  Status   = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, NULL);
+  if (Status != EFI_BUFFER_TOO_SMALL) {
+    Status = EFI_ERROR (Status) ? Status : EFI_DEVICE_ERROR;
+    goto Done;
+  }
+
+  Info = AllocatePool (InfoSize);
+  if (Info == NULL) {
+    Status = EFI_OUT_OF_RESOURCES;
+    goto Done;
+  }
+
+  Status = File->GetInfo (File, &gEfiFileInfoGuid, &InfoSize, Info);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  FileSize = (UINTN)Info->FileSize;
+  if ((FileSize < sizeof (UINT64)) || (FileSize > SIZE_32MB)) {
+    DEBUG ((DEBUG_WARN, "%a: '%s' is not a plausible devicetree (0x%lx bytes)\n",
+      __func__, Path, (UINT64)FileSize));
+    Status = EFI_VOLUME_CORRUPTED;
+    goto Done;
+  }
+
+  //
+  // Room for the fixups on the end, and EfiACPIReclaimMemory so the tree
+  // outlives ExitBootServices -- the OS reads it long after we are gone.
+  //
+  BufferSize = FileSize + FDT_FIXUP_HEADROOM;
+  Pages      = EFI_SIZE_TO_PAGES (BufferSize);
+  Status     = gBS->AllocatePages (AllocateAnyPages, EfiACPIReclaimMemory, Pages, &Buffer);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  BufferSize = EFI_PAGES_TO_SIZE (Pages);
+  Status     = File->Read (File, &FileSize, (VOID *)(UINTN)Buffer);
+  if (EFI_ERROR (Status)) {
+    goto Done;
+  }
+
+  //
+  // Same path a systemd-boot caller takes, so a tree from the ESP and a tree
+  // from a UKI get treated identically.
+  //
+  Status = Rpi5DtFixup (&mDtFixupProtocol, (VOID *)(UINTN)Buffer, &BufferSize, EFI_DT_ALL);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((DEBUG_ERROR, "%a: fixup of '%s' failed: %r\n", __func__, Path, Status));
+    goto Done;
+  }
+
+  //
+  // Installed, so this tree has to outlive the function -- and whatever we
+  // handed over before it does not.
+  //
+  if (mOsFdtPages != 0) {
+    gBS->FreePages (mOsFdtBuffer, mOsFdtPages);
+  }
+
+  mOsFdtBuffer = Buffer;
+  mOsFdtPages  = Pages;
+  Pages        = 0;
+
+  DEBUG ((DEBUG_INFO, "%a: handed the OS its own devicetree from '%s'\n", __func__, Path));
+
+Done:
+  if (Info != NULL) {
+    FreePool (Info);
+  }
+
+  if ((Pages != 0) && (Buffer != 0)) {
+    gBS->FreePages (Buffer, Pages);
+  }
+
+  if (File != NULL) {
+    File->Close (File);
+  }
+
+  if (Root != NULL) {
+    Root->Close (Root);
+  }
+
+  return Status;
+}
+
+/**
+  Look for one device tree path on every filesystem we can see, and hand the
+  OS the first one that loads.
+
+  @param  Path[in]  Path to try on each volume.
+
+  @retval EFI_SUCCESS  A tree was loaded, fixed up and installed.
+  @retval other        No volume carries this path.
+
+**/
+STATIC
+EFI_STATUS
+LoadFdtByPath (
+  IN CONST CHAR16  *Path
+  )
+{
+  EFI_STATUS  Status;
+  EFI_HANDLE  *Handles;
+  UINTN       HandleCount;
+  UINTN       Index;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status)) {
+    return Status;
+  }
+
+  Status = EFI_NOT_FOUND;
+  for (Index = 0; Index < HandleCount; Index++) {
+    if (!EFI_ERROR (TryLoadFdtFromVolume (Handles[Index], Path))) {
+      Status = EFI_SUCCESS;
+      break;
+    }
+  }
+
+  FreePool (Handles);
+
+  return Status;
+}
+
+/**
+  At ReadyToBoot, prefer a device tree the OS installed over the one the VPU
+  bootloader loaded.
+
+  Late rather than at driver init because filesystems do not exist yet when
+  FdtDxe runs. The unkeyed path only: EfiBootManagerBoot() signals ReadyToBoot
+  in step 3, before the gBS->LoadImage() in step 5, so there is no kernel here
+  yet to key on. OnImageLoaded() below supersedes this once there is one, and
+  this stays the answer for everything that is not a UKI.
+
+  Anything that brings its own tree later -- a UKI .dtb section through the
+  fixup protocol -- still wins, because it installs its table after this fires.
+
+**/
+STATIC
+VOID
+EFIAPI
+LoadFdtFromOsVolume (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  LoadFdtByPath (FDT_OS_PATH);
+}
+
+/**
+  Find one section of a PE image that is already loaded into memory.
+
+  The section table is part of the headers, and the loader copies the headers
+  to the image base along with everything else, so a loaded image can be asked
+  about its own layout without going back to the file it came from. This is
+  what systemd-stub does to find its own sections, in
+  pe_memory_locate_sections().
+
+  @param  ImageBase[in]  Base of the loaded image.
+  @param  ImageSize[in]  Its size, for bounds checking.
+  @param  Name[in]       Section name, at most 8 characters.
+  @param  Data[out]      Start of the section's contents.
+  @param  Size[out]      Their length.
+
+  @retval EFI_SUCCESS    Found.
+  @retval EFI_NOT_FOUND  No such section, or this is not a PE image.
+
+**/
+STATIC
+EFI_STATUS
+PeLocateSection (
+  IN  CONST VOID   *ImageBase,
+  IN  UINTN        ImageSize,
+  IN  CONST CHAR8  *Name,
+  OUT CONST VOID   **Data,
+  OUT UINTN        *Size
+  )
+{
+  CONST EFI_IMAGE_DOS_HEADER      *DosHdr;
+  CONST EFI_IMAGE_NT_HEADERS64    *NtHdr;
+  CONST EFI_IMAGE_SECTION_HEADER  *Section;
+  CHAR8                           Padded[EFI_IMAGE_SIZEOF_SHORT_NAME];
+  UINTN                           Offset;
+  UINTN                           Index;
+
+  if ((ImageBase == NULL) || (ImageSize < sizeof (EFI_IMAGE_NT_HEADERS64))) {
+    return EFI_NOT_FOUND;
+  }
+
+  //
+  // Section names are a fixed 8 bytes, zero-padded and not necessarily
+  // terminated, so compare them as bytes rather than as strings.
+  //
+  ZeroMem (Padded, sizeof (Padded));
+  CopyMem (Padded, Name, AsciiStrnLenS (Name, sizeof (Padded)));
+
+  Offset = 0;
+  DosHdr = (CONST EFI_IMAGE_DOS_HEADER *)ImageBase;
+  if (DosHdr->e_magic == EFI_IMAGE_DOS_SIGNATURE) {
+    Offset = (UINTN)DosHdr->e_lfanew;
+  }
+
+  if (Offset > ImageSize - sizeof (EFI_IMAGE_NT_HEADERS64)) {
+    return EFI_NOT_FOUND;
+  }
+
+  NtHdr = (CONST EFI_IMAGE_NT_HEADERS64 *)((CONST UINT8 *)ImageBase + Offset);
+  if (NtHdr->Signature != EFI_IMAGE_NT_SIGNATURE) {
+    return EFI_NOT_FOUND;
+  }
+
+  Offset += OFFSET_OF (EFI_IMAGE_NT_HEADERS64, OptionalHeader) +
+            NtHdr->FileHeader.SizeOfOptionalHeader;
+
+  for (Index = 0; Index < NtHdr->FileHeader.NumberOfSections; Index++) {
+    if (Offset > ImageSize - sizeof (EFI_IMAGE_SECTION_HEADER)) {
+      return EFI_NOT_FOUND;
+    }
+
+    Section = (CONST EFI_IMAGE_SECTION_HEADER *)((CONST UINT8 *)ImageBase + Offset);
+    Offset += sizeof (EFI_IMAGE_SECTION_HEADER);
+
+    if (CompareMem (Section->Name, Padded, sizeof (Padded)) != 0) {
+      continue;
+    }
+
+    if ((Section->Misc.VirtualSize == 0) ||
+        (Section->VirtualAddress > ImageSize) ||
+        (Section->Misc.VirtualSize > ImageSize - Section->VirtualAddress))
+    {
+      return EFI_NOT_FOUND;
+    }
+
+    *Data = (CONST UINT8 *)ImageBase + Section->VirtualAddress;
+    *Size = Section->Misc.VirtualSize;
+
+    return EFI_SUCCESS;
+  }
+
+  return EFI_NOT_FOUND;
+}
+
+/**
+  Read the kernel release out of a loaded image, if it is a unified kernel
+  image at all.
+
+  @param  LoadedImage[in]  The image to inspect.
+  @param  Uname[out]       Buffer of FDT_OS_UNAME_MAX + 1 bytes.
+
+  @retval EFI_SUCCESS    Uname holds a kernel release usable as a path
+                         component.
+  @retval EFI_NOT_FOUND  Not a UKI, or its .uname is not usable.
+
+**/
+STATIC
+EFI_STATUS
+UkiGetUname (
+  IN  CONST EFI_LOADED_IMAGE_PROTOCOL  *LoadedImage,
+  OUT CHAR8                            *Uname
+  )
+{
+  CONST VOID   *Data;
+  CONST CHAR8  *Release;
+  UINTN        Size;
+  UINTN        Index;
+
+  //
+  // A .uname alone would not be enough to go on: systemd-stub's addons carry
+  // one too, and the stub loads them in this same window, from inside the
+  // very image we are trying to characterise. The kernel is what separates
+  // the two.
+  //
+  if (EFI_ERROR (
+        PeLocateSection (
+          LoadedImage->ImageBase,
+          LoadedImage->ImageSize,
+          UKI_SECTION_LINUX,
+          &Data,
+          &Size
+          )
+        ))
+  {
+    return EFI_NOT_FOUND;
+  }
+
+  if (EFI_ERROR (
+        PeLocateSection (
+          LoadedImage->ImageBase,
+          LoadedImage->ImageSize,
+          UKI_SECTION_UNAME,
+          &Data,
+          &Size
+          )
+        ))
+  {
+    return EFI_NOT_FOUND;
+  }
+
+  //
+  // ukify writes the release with no terminator and pads the section out with
+  // zeroes, so take the characters that are legal in a kernel release and
+  // stop at the first that is not. A separator is not among them, so whatever
+  // comes back is one path component under \dtb and cannot reach outside it.
+  //
+  Release = (CONST CHAR8 *)Data;
+  for (Index = 0; (Index < Size) && (Index < FDT_OS_UNAME_MAX); Index++) {
+    if (((Release[Index] >= '0') && (Release[Index] <= '9')) ||
+        ((Release[Index] >= 'A') && (Release[Index] <= 'Z')) ||
+        ((Release[Index] >= 'a') && (Release[Index] <= 'z')) ||
+        (Release[Index] == '.') || (Release[Index] == '-') ||
+        (Release[Index] == '_') || (Release[Index] == '+'))
+    {
+      Uname[Index] = Release[Index];
+      continue;
+    }
+
+    break;
+  }
+
+  Uname[Index] = '\0';
+
+  return (Index == 0) ? EFI_NOT_FOUND : EFI_SUCCESS;
+}
+
+/**
+  When an image is loaded and turns out to be the OS, swap the device tree for
+  the one built against that kernel.
+
+  A LoadedImage notify rather than anything earlier or later because of where
+  EfiBootManagerBoot() puts its steps: ReadyToBoot is signalled in step 3, the
+  boot option is loaded in step 5 and entered in step 8. The window in which
+  the kernel release is knowable but the OS has not been entered yet is
+  therefore exactly the moment gBS->LoadImage() installs this protocol on the
+  image's handle.
+
+**/
+STATIC
+VOID
+EFIAPI
+OnImageLoaded (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  EFI_STATUS                 Status;
+  EFI_LOADED_IMAGE_PROTOCOL  *LoadedImage;
+  EFI_HANDLE                 Handle;
+  UINTN                      BufferSize;
+  CHAR8                      Uname[FDT_OS_UNAME_MAX + 1];
+  CHAR16                     Path[FDT_OS_UNAME_MAX + 32];
+
+  while (TRUE) {
+    BufferSize = sizeof (Handle);
+    Status     = gBS->LocateHandle (
+                        ByRegisterNotify,
+                        NULL,
+                        mLoadedImageRegistration,
+                        &BufferSize,
+                        &Handle
+                        );
+    if (EFI_ERROR (Status)) {
+      break;
+    }
+
+    //
+    // The queue has to be drained even once we are done with it, or the next
+    // signal hands us back what we already declined.
+    //
+    if (mOsFdtMatched) {
+      continue;
+    }
+
+    Status = gBS->HandleProtocol (
+                    Handle,
+                    &gEfiLoadedImageProtocolGuid,
+                    (VOID **)&LoadedImage
+                    );
+    if (EFI_ERROR (Status)) {
+      continue;
+    }
+
+    if (EFI_ERROR (UkiGetUname (LoadedImage, Uname))) {
+      continue;
+    }
+
+    //
+    // One shot, answered or not: if no tree is keyed to this kernel then the
+    // unkeyed one ReadyToBoot installed stands, and asking again for every
+    // image the OS goes on to load would only risk a worse answer.
+    //
+    mOsFdtMatched = TRUE;
+
+    UnicodeSPrint (Path, sizeof (Path), FDT_OS_PATH_FMT, Uname);
+
+    Status = LoadFdtByPath (Path);
+    DEBUG ((
+      DEBUG_INFO,
+      "%a: booting %a: '%s': %r\n",
+      __func__,
+      Uname,
+      Path,
+      Status
+      ));
+  }
+}
