 #define FDT_FIXUP_HEADROOM  SIZE_4KB
 
+//
+// Where a device tree may be placed on a filesystem we can see.
+//
+// This is the answer to a firmware that would otherwise have to be reflashed
+// for every kernel: the device tree has to match the kernel, so let it live
+// with the kernel's installation instead of on the firmware's card. Whoever
+// installs the OS drops the tree its kernel was built against here, and the
+// same firmware image boots it.
+//
+// Two shapes are looked for:
+//
+//   \dtb\<kernel release>\bcm2712-rpi-5-b.dtb   -- keyed to one kernel
+//   \dtb\bcm2712-rpi-5-b.dtb                    -- whatever boots
+//
+// The keyed form is there because "the tree that matches the kernel" stops
+// being a single answer on a machine that keeps two kernels around. An A/B
+// upgrade -- Talos being the case in hand -- installs the new image alongside
+// the old and expects a failed boot to fall back to it; with one tree at a
+// fixed path, that fallback runs last month's kernel against this month's
+// tree, which is the exact mismatch this whole mechanism exists to avoid.
+// <kernel release> is the booting UKI's .uname section verbatim, i.e. the
+// `uname -r` string such as "6.18.44-talos", so the two are paired by
+// construction rather than by an installer remembering to keep them in step.
+//
+// One fixed leaf name, deliberately. Guessing between the Pi 5 variants
+// (bcm2712-rpi-5-b / bcm2712d0-rpi-5-b / bcm2712-d-rpi-5-b) from a board
+// revision would put us in the business of reimplementing the VPU
+// bootloader's model-to-filename mapping, and getting it wrong hands the OS a
+// tree for different silicon. Placing the right file is the installer's job,
+// exactly as it is for config.txt's device_tree=.
+//
+#define FDT_OS_LEAF      L"bcm2712-rpi-5-b.dtb"
+#define FDT_OS_PATH      L"\\dtb\\" FDT_OS_LEAF
+#define FDT_OS_PATH_FMT  L"\\dtb\\%a\\" FDT_OS_LEAF
+
+//
+// Longest kernel release we will build a path out of. Linux caps its own
+// release string at 64 (__NEW_UTS_LEN), so anything longer than this did not
+// come from a kernel and has no business being concatenated into a path.
+//
+#define FDT_OS_UNAME_MAX  64
+
+//
+// The two sections of a unified kernel image that concern us. .linux is what
+// makes an image a UKI rather than some other loader that happens to be
+// booting -- systemd-stub uses its presence for the same test, in reverse,
+// to reject a UKI handed to it as an addon -- and .uname is the kernel
+// release inside it.
+//
+#define UKI_SECTION_LINUX  ".linux"
+#define UKI_SECTION_UNAME  ".uname"
+
