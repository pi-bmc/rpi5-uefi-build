From: pi-bmc <nbatkins@gmail.com>
Subject: [PATCH] rpi5: forward the SCMI doorbell SiP SMC into OP-TEE

Linux's arm,scmi-smc transport rings a fast SiP SMC after writing the
message into the static SMT page; the SCMI server lives in OP-TEE. Add a
SiP runtime service (the OEN is otherwise unused here -- the PCI config
SMCs are Standard Service calls dispatched by std_svc_setup.c) that
forwards RPI_SIP_SCMI_AGENT0 (0x82000010) into OP-TEE's fast-SMC vector,
mirroring opteed_smc_handler's fresh-request path via the dispatcher's
exported per-core contexts. OP-TEE returns through the normal
TEESMC_OPTEED_RETURN_CALL_DONE leg, which lands the results straight
back in the non-secure caller. Only fast calls are forwarded, and only
once OP-TEE is resident on the calling core.

Applies on top of 0001 (SPD=opteed support); compiled out entirely when
SPD is not opteed.

---
diff --git a/plat/rpi/common/rpi_scmi_svc.c b/plat/rpi/common/rpi_scmi_svc.c
new file mode 100644
index 000000000..f0a121f6b
--- /dev/null
+++ b/plat/rpi/common/rpi_scmi_svc.c
@@ -0,0 +1,126 @@
+/*
+ * Copyright (c) 2026, pi-bmc contributors
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * SiP runtime service: the SCMI doorbell.
+ *
+ * Linux's arm,scmi-smc transport writes an SCMI message into the static
+ * SMT shared-memory page and rings a fast SiP SMC (arm,smc-id in the DT,
+ * RPI_SIP_SCMI_AGENT0 here). The SCMI server lives in OP-TEE (BL32), so
+ * this handler forwards the call into OP-TEE's fast-SMC vector exactly
+ * the way opteed's own TOS-range path does: save the non-secure context,
+ * point ELR at optee_vector_table->fast_smc_entry and ERET into S-EL1
+ * with the original function ID in x0. OP-TEE's plat-rpi5 tee_entry_fast
+ * override recognises the ID, processes SMT channel 0 and finishes with
+ * TEESMC_OPTEED_RETURN_CALL_DONE - whereupon opteed restores the saved
+ * non-secure context and returns OP-TEE's x0..x3 straight to the SCMI
+ * caller. This handler never sees the return leg.
+ *
+ * Only fast calls are forwarded: a yielding forward would surface
+ * OP-TEE's RPC return codes to a caller that does not speak them.
+ *
+ * The SiP OEN is otherwise unused on this platform (the PCI config SMCs
+ * are Standard Service calls dispatched by std_svc_setup.c), so this
+ * service owns the whole range.
+ */
+
+#include <assert.h>
+
+#include <common/debug.h>
+#include <common/runtime_svc.h>
+#include <lib/el3_runtime/context_mgmt.h>
+#include <lib/smccc.h>
+#include <plat/common/platform.h>
+#include <smccc_helpers.h>
+
+#include "opteed_private.h"
+
+/* Standard SiP service queries */
+#define RPI_SIP_SVC_CALL_COUNT	U(0x8200ff00)
+#define RPI_SIP_SVC_UID		U(0x8200ff01)
+#define RPI_SIP_SVC_VERSION	U(0x8200ff03)
+
+/*
+ * SCMI agent 0 doorbell: OP-TEE's SMT fastcall channel 0. Keep in step
+ * with OP-TEE plat-rpi5 (scmi_server.c) and the arm,smc-id property
+ * EDK2's FdtDxe writes into the OS device tree.
+ */
+#define RPI_SIP_SCMI_AGENT0	U(0x82000010)
+
+#define RPI_SIP_NUM_CALLS	U(1)
+#define RPI_SIP_VERSION_MAJOR	U(1)
+#define RPI_SIP_VERSION_MINOR	U(0)
+
+DEFINE_SVC_UUID2(rpi_sip_svc_uid,
+		 0x3cdb3d44, 0x02d0, 0x4f99, 0x84, 0x04,
+		 0xd4, 0x6e, 0xb4, 0x2f, 0x4e, 0x1b);
+
+static uintptr_t rpi_sip_forward_to_optee(uint32_t smc_fid, u_register_t x1,
+					  u_register_t x2, u_register_t x3,
+					  void *handle)
+{
+	uint32_t linear_id = plat_my_core_pos();
+	optee_context_t *optee_ctx = &opteed_sp_context[linear_id];
+
+	/* OP-TEE must be up and resident on this core */
+	if ((optee_vector_table == NULL) ||
+	    (get_optee_pstate(optee_ctx->state) != OPTEE_PSTATE_ON)) {
+		SMC_RET1(handle, SMC_UNK);
+	}
+
+	/*
+	 * Mirror of opteed_smc_handler's fresh-request path for a fast
+	 * call: stash the non-secure state, enter OP-TEE's fast SMC
+	 * vector with the original function ID. The matching return
+	 * (TEESMC_OPTEED_RETURN_CALL_DONE) is handled by opteed, which
+	 * restores the context saved here.
+	 */
+	assert(handle == cm_get_context(NON_SECURE));
+	cm_el1_sysregs_context_save(NON_SECURE);
+
+	assert(&optee_ctx->cpu_ctx == cm_get_context(SECURE));
+	cm_set_elr_el3(SECURE,
+		       (uint64_t)&optee_vector_table->fast_smc_entry);
+	cm_el1_sysregs_context_restore(SECURE);
+	cm_set_next_eret_context(SECURE);
+
+	SMC_RET4(&optee_ctx->cpu_ctx, smc_fid, x1, x2, x3);
+}
+
+static uintptr_t rpi_sip_smc_handler(uint32_t smc_fid, u_register_t x1,
+				     u_register_t x2, u_register_t x3,
+				     u_register_t x4, void *cookie,
+				     void *handle, u_register_t flags)
+{
+	if (is_caller_secure(flags)) {
+		SMC_RET1(handle, SMC_UNK);
+	}
+
+	switch (smc_fid) {
+	case RPI_SIP_SCMI_AGENT0:
+		return rpi_sip_forward_to_optee(smc_fid, x1, x2, x3, handle);
+
+	case RPI_SIP_SVC_CALL_COUNT:
+		SMC_RET1(handle, RPI_SIP_NUM_CALLS);
+
+	case RPI_SIP_SVC_UID:
+		SMC_UUID_RET(handle, rpi_sip_svc_uid);
+
+	case RPI_SIP_SVC_VERSION:
+		SMC_RET2(handle, RPI_SIP_VERSION_MAJOR, RPI_SIP_VERSION_MINOR);
+
+	default:
+		WARN("Unimplemented RPi SiP call: 0x%x\n", smc_fid);
+		SMC_RET1(handle, SMC_UNK);
+	}
+}
+
+DECLARE_RT_SVC(
+	rpi_sip_svc,
+	OEN_SIP_START,
+	OEN_SIP_END,
+	SMC_TYPE_FAST,
+	NULL,
+	rpi_sip_smc_handler
+);
diff --git a/plat/rpi/rpi5/platform.mk b/plat/rpi/rpi5/platform.mk
index 70c5add25..ca0a9a7b4 100644
--- a/plat/rpi/rpi5/platform.mk
+++ b/plat/rpi/rpi5/platform.mk
@@ -113,3 +113,12 @@ endif
 ifeq ($(SMC_PCI_SUPPORT), 1)
 BL31_SOURCES		+=	plat/rpi/common/rpi_pci_svc.c
 endif
+
+# With OP-TEE as BL32, expose the SCMI doorbell: a SiP fast SMC that
+# rpi_scmi_svc.c forwards into OP-TEE's fast-SMC vector (the server and
+# the SMT channel live in OP-TEE's plat-rpi5). The service reuses the
+# opteed dispatcher's exported per-core contexts, hence the include.
+ifeq (${SPD},opteed)
+BL31_SOURCES		+=	plat/rpi/common/rpi_scmi_svc.c
+PLAT_INCLUDES		+=	-Iservices/spd/opteed
+endif
