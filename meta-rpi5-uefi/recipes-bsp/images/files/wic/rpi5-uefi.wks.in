# Raspberry Pi 5 UEFI firmware SD/NVMe image (WIC kickstart).
#
# @SDIMG_BOOT_MB@ is substituted by the recipe. MBR (msdos) to match the
# proven layout the VPU bootloader reads; the single boot partition is
# FAT32 LBA, active, 4 MiB aligned.
#
# Populated from a staging tree the recipe assembles (rootfs source,
# default ROOTFS_DIR) rather than IMAGE_BOOT_FILES: the DTB layout (each
# tree at the root, under broadcom/, and under dtb/<release>/) does not map
# onto IMAGE_BOOT_FILES cleanly.

bootloader --ptable msdos

part /boot --source rootfs --rootfs-dir=ROOTFS_DIR --fstype=vfat \
      --label RPI5-UEFI --fixed-size @SDIMG_BOOT_MB@M --align 4096 --active
